# VERTEX Docker Environment Variables
# Copy this file to .env and modify as needed for your environment

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=vertex_projects
MYSQL_USER=vertex_user
MYSQL_PASSWORD=vertex_pass
MYSQL_PORT=3306

# ============================================
# Spring Boot Configuration
# ============================================
BACKEND_PORT=8080
PORT=8080

# ============================================
# JWT Configuration
# ============================================
# Secret key for JWT token signing (must be at least 64 bytes/512 bits)
JWT_SECRET=VERTEX-ENTERPRISE-SECRET-KEY-FOR-JWT-TOKEN-OPERATIONS-MIN-512-BITS-64-BYTES-LENGTH-REQUIRED-FOR-HS512-ALGORITHM
# JWT expiration time in milliseconds (default: 86400000 = 24 hours)
JWT_EXP_MS=86400000

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:5500

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL=INFO

# ============================================
# Application Profile
# ============================================
# Options: development, staging, production
SPRING_PROFILES_ACTIVE=development

# ============================================
# Email Configuration (Optional)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@vertex-projects.com

# ============================================
# Additional JVM Options (Optional)
# ============================================
# More memory for production: -Xmx2g -Xms1g
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ============================================
# File Upload Configuration
# ============================================
# Maximum file size in MB
MAX_FILE_SIZE=25

# ============================================
# Database Connection Pool
# ============================================
DB_POOL_MAX=20
DB_POOL_MIN=5

